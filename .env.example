# Primary player: your authorized VidSrc HTTPS embed URL template.
# Required placeholders: {malId} and {episode}; optional placeholder: {audio}
# Add the same value to GitHub repo Settings > Secrets and variables > Actions > Variables
# as VITE_VIDSRC_TEMPLATE so GitHub Pages builds can use it.
VITE_VIDSRC_TEMPLATE=

# Optional additional player and backup player templates (HTTPS only).
# Required placeholders: {malId} and {episode}; optional placeholder: {audio}
VITE_EMBED_TEMPLATE=
VITE_EMBED_NAME=Embed player
VITE_FALLBACK_EMBED_TEMPLATE=
VITE_FALLBACK_EMBED_NAME=Backup player

# Used only for the optional backend warm-up ping.
VITE_KUHI_API_URL=https://anime-api-jqpp.onrender.com

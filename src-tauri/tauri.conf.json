{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniOrbit",
  "version": "1.0.0",
  "identifier": "com.aniorbit.desktop",
  "build": {
    "devUrl": "https://aniorbit.pages.dev",
    "frontendDist": "https://aniorbit.pages.dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AniOrbit",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
